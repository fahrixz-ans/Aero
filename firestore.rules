rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checking if user has admin privileges.
    // Bootstrapped using the user's registered runtime email or an admins collection document.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'fahriandriansaputra123@gmail.com' ||
        request.auth.token.email == 'admin@aeroapk.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users & private data
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /bookmarks/{appId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /history/{historyId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Admins list
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Applications collection
    match /applications/{applicationId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /changelogs/{changelogId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      
      match /screenshots/{screenshotId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Feedback collection - Anyone can submit (create), only admins can manage (read, update, delete)
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Newsletter Subscribers
    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
